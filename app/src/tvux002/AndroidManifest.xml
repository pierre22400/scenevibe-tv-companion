<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Package visibility for the explicit user-selected normal TV launch, not a new permission. -->
    <queries><package android:name="com.amazon.amazonvideo.livingroom" /></queries>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <application android:usesCleartextTraffic="false">
        <receiver android:name=".BootReceiver" android:enabled="false" />
    </application>
</manifest>
