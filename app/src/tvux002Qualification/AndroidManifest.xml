<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Same production visibility, plus one OWN viewer only in disposable native qualification. -->
    <queries><package android:name="com.amazon.amazonvideo.livingroom" /></queries>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <application android:usesCleartextTraffic="false">
        <receiver android:name=".BootReceiver" android:enabled="false" />
        <!-- Stable principal-package target; enabled only in the explicitly requested MUTE candidate. -->
        <service
            android:name=".CompanionShortcutService"
            android:enabled="${scenevibeCompanionMuteEnabled}"
            android:exported="true"
            android:label="@string/companion_shortcut_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/companion_shortcut" />
        </service>
        <activity android:name=".DeveloperViewerFixtureActivity" android:exported="false" />
    </application>
</manifest>
