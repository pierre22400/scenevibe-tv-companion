<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.amazon.amazonvideo.livingroom" />
    </queries>
    <application android:usesCleartextTraffic="false">
        <receiver android:name=".BootReceiver" android:enabled="false" />
        <receiver android:name=".PublicViewerBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".PublicCompanionService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
        <service
            android:name=".CompanionShortcutService"
            android:enabled="${scenevibeCompanionMuteEnabled}"
            android:exported="true"
            android:label="@string/companion_shortcut_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/companion_shortcut" />
        </service>
    </application>
</manifest>
